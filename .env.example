ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Added in later steps. Never commit real values to .env.
GEMINI_API_KEY=
COHERE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
EVALUATION_DEEPSEEK_MODEL=deepseek-v4-flash
EVALUATION_THROTTLE_SECONDS=20
ANSWER_MAX_COMPLETION_TOKENS=4096
COHERE_RERANK_MODEL=rerank-v4.0-pro
AGENT_RECURSION_LIMIT=4
AGENT_PLAN_MAX_SUBQUESTIONS=4
AGENT_PLAN_MAX_COMPLETION_TOKENS=8192
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=research_chunks
LEXICAL_INDEX_PATH=data/lexical.db
INGESTION_MAX_FILE_SIZE_BYTES=26214400
